# Set these only in your shell or in a local ignored file. Never commit values.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PERCENT_ENCODED_PASSWORD@HOST:5432/postgres
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# `npm run apply` refuses to write without this backup acknowledgement.
SUPABASE_BACKUP_CONFIRMED=yes
